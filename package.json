{
  "name": "vidfetch",
  "version": "1.0.0",
  "description": "Minimal, fast video & audio downloader for Windows and Linux.",
  "main": "electron/main.js",
  "author": "larin-ilya",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.vidfetch.desktop",
    "productName": "VidFetch",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "engine/dist/", "to": "engine/", "filter": ["**/*"] },
      { "from": "build/ffmpeg/", "to": "ffmpeg/", "filter": ["**/*"] }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "maintainer": "larin-ilya",
      "icon": "assets/icon.png"
    }
  }
}
